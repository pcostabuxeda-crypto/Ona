{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Finestra principal i lletra flotant",
  "windows": [
    "main",
    "lyrics-mini"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
