{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ona",
  "version": "0.1.0",
  "identifier": "cat.ona.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ona",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#09090f"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://*.scdn.co https://*.spotifycdn.com https://*.spotify.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Ona — música lleugera"
  }
}